# Copy to .env (gitignored) and fill in. Environment variables that are already set win over this file.

# Which model every agent uses: provider:model
#   ollama:<model>              a local Ollama model (default: ollama:granite4.1:3b)
#   lmstudio:<model>            a model in LM Studio (server on port 1234)
#   anthropic:claude-haiku-5-5  Anthropic API (needs the key below)
RIVALS_ATLAS_LLM=ollama:granite4.1:3b

# Only for the anthropic provider
ANTHROPIC_API_KEY=
