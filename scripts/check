#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."

step() { printf '== %s\n' "$1"; }

step "ruff format"
uv run ruff format --check src

step "ruff lint"
uv run ruff check src

step "mypy"
uv run mypy src

if [ -d tests ]; then
  step "pytest"
  uv run pytest -q
fi

step "tsc"
(cd frontend && npx tsc -b)

step "oxlint"
(cd frontend && npx oxlint --deny-warnings)

step "shell syntax"
for f in scripts/check scripts/setup.sh "installers/macos/Start Rivals Atlas.command"; do bash -n "$f"; done

slop="${SLOP_CHECK:-$HOME/.claude/hooks/slop_check.py}"
if [ -f "$slop" ]; then
  step "docs and comments"
  git ls-files -z --cached --others --exclude-standard | xargs -0 python3 -I "$slop"
fi

echo "all checks passed"
